# Supabase Postgres: Project Settings -> Database -> Connection string -> "Session pooler" (IPv4; Render can't reach the
# IPv6-only direct connection). Looks like postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# URL-encode special characters in the password. Leave unset locally to use a SQLite file.
DATABASE_URL=
# Long random string used to sign login tokens. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=1440
# Free key from https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
# Used to resolve "today", "Friday", "this week"
APP_TIMEZONE=Asia/Kolkata
# The first admin account is created on startup from these (only if it does not exist yet)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin
